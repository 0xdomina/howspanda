# How's u — production deployment environment
#
# Topology: storefront + Manage Business → Vercel · API/worker → PandaStack
# · database → Neon · cache/queues → Aiven Valkey · media → Backblaze B2 (S3)
#
# Copy to .env.deploy (never committed), fill REAL values, then paste each
# section into the right host: PANDASTACK gets the backend section, VERCEL gets
# the frontend section (Project → Settings → Environment Variables).
#
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ============================================================================
# BACKEND (PandaStack)
# ============================================================================

# --- Auth secrets (REQUIRED; must be 32+ random bytes, non-default) ---
JWT_SECRET=replace-with-32-byte-random-hex
COOKIE_SECRET=replace-with-32-byte-random-hex

# --- Data plane (Neon Postgres + Aiven Valkey/Redis; use their connection strings) ---
DATABASE_URL=postgres://user:password@host:5432/howsu
REDIS_URL=redis://default:password@host:6379

# --- CORS / URLs ---
# Backend's own public URL (webhook callbacks, Google OAuth callback base).
BACKEND_URL=https://api.yourdomain.com
# Storefront origin(s) Vercel serves — add preview URLs as needed.
STORE_CORS=https://yourdomain.com
ADMIN_CORS=https://yourdomain.com,https://admin.yourdomain.com
AUTH_CORS=https://yourdomain.com,https://admin.yourdomain.com

# --- Payment webhook reliability (optional; sane defaults) ---
WEBHOOK_DELAY_MS=5000
WEBHOOK_RETRIES=3
# Direct-transfer proof stays open this long after a seller cannot find the
# payment. The order is auto-closed after the window; neither screenshot nor
# buyer-entered amount can mark an order paid.
BANK_TRANSFER_RECHECK_HOURS=24

# --- Media storage: Backblaze B2 via S3-compatible API ---
# Create the bucket in B2, make files public-read (bucket settings), create an
# application key with read+write access to that bucket.
# region + endpoint: B2 dashboard shows e.g. us-west-004 / s3.us-west-004.backblazeb2.com
# S3_URL: the bucket's PUBLIC file host (or your CDN domain in front of it):
#   https://f004.backblazeb2.com/<bucket-name>   (match the region number)
S3_URL=https://f004.backblazeb2.com/your-bucket-name
S3_BUCKET=your-bucket-name
S3_REGION=us-west-004
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY_ID=your-b2-key-id
S3_SECRET_ACCESS_KEY=your-b2-application-key
# Optional key prefix inside the bucket (e.g. media/). Leave empty for none.
S3_PREFIX=

# Separate private bucket for bank-transfer proof images. Do not reuse the
# public product-media bucket. The API serves five-minute signed read URLs.
PRIVATE_S3_BUCKET=your-private-proof-bucket
PRIVATE_S3_REGION=us-west-004
PRIVATE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
PRIVATE_S3_ACCESS_KEY_ID=your-private-b2-key-id
PRIVATE_S3_SECRET_ACCESS_KEY=your-private-b2-application-key
PRIVATE_S3_PREFIX=payment-proofs
PRIVATE_S3_FORCE_PATH_STYLE=true

# --- Payments: fiat rails (test keys work immediately; `mock` = offline) ---
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
FLUTTERWAVE_SECRET_KEY=flw-live-xxx
FLUTTERWAVE_PUBLIC_KEY=flw-live-pk-xxx
PAYMENT_DEFAULT_CURRENCY=ngn

# --- Payments: crypto USDC via Circle programmable wallets ---
CRYPTO_ENABLED=true
CRYPTO_NETWORK_ENV=mainnet            # testnet | mainnet
CRYPTO_DEFAULT_NETWORK=base           # base | solana
# Required: inject the current rate from your approved pricing/oracle process.
CRYPTO_NGN_PER_USDC=
# Circle developer console → API keys + entity secret. The entity secret is
# required for wallet creation and transaction signing (user wallets, payouts).
CIRCLE_API_KEY=replace-with-circle-api-key
CIRCLE_ENTITY_SECRET=replace-with-64-character-hex-entity-secret
# Circle wallet account type: SCA needs sponsored gas; EOA needs native gas.
CIRCLE_ACCOUNT_TYPE=SCA
CIRCLE_API_BASE_URL=https://api.circle.com
# One wallet set holds every platform wallet (users, deposits, treasury).
# Create it once (Circle console or API) and paste the id.
CIRCLE_WALLET_SET_ID=your-wallet-set-id
WALLET_RECONCILE_ENABLED=true

# --- Optional: Arc network (direct L1, USDC-native; off by default) ---
# ARC_MNEMONIC=
# ARC_PRIVATE_KEY=
# ARC_RPC_URL=https://rpc.arc.io

# --- Escrow & payouts ---
ESCROW_RETURN_WINDOW_DAYS=3
ESCROW_FALLBACK_RELEASE_DAYS=30
PAYOUT_MIN_NGN=5000
PAYOUT_SCHEDULE_ENABLED=true          # enable the cron payout/reconcile sweeps

# --- AI (platform-owned, seller-facing) ---
AI_PROVIDER=groq                      # groq | mock | mock-fail
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_xxx
AI_FREE_TIER_MONTHLY_LIMIT=100
AI_ROUTER_PROVIDERS=groq
AI_ROUTER_STRATEGY=failover
AI_BUYER_CHAT_DAILY_LIMIT=30
# Optional safety/performance controls for the platform-owned commerce router.
AI_CHAT_MAX_OUTPUT_TOKENS=600
AI_REQUEST_TIMEOUT_MS=30000
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional OpenAI-compatible provider pool, JSON configured on the backend only.
# AI_ROUTER_EXTRA_PROVIDERS=[{"id":"provider-id","name":"Provider","baseURL":"https://api.example.com/v1","apiKeyEnv":"PROVIDER_API_KEY","model":"model-id"}]

# --- KYC verification (couriers/sellers) ---
KYC_VERIFICATION_ENABLED=true
KYC_VERIFICATION_CHANNEL=whatsapp     # email | whatsapp | mock
KYC_EMAIL_API_KEY=
KYC_EMAIL_FROM=verify@yourdomain.com
KYC_WHATSAPP_ACCESS_TOKEN=
KYC_WHATSAPP_PHONE_NUMBER_ID=
KYC_COURIER_GATE_ENABLED=true

# --- Out-of-band notifications (team invites etc.) ---
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_CHANNEL=brevo           # email (Resend) | brevo (SMTP) | mock
EMAIL_FROM="How's u <no-reply@yourdomain.com>"
BREVO_SENDER_EMAIL=verified-sender@yourdomain.com
BREVO_REPLY_TO=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_PASS=your-brevo-smtp-key
BREVO_SMTP_CONNECTION_TIMEOUT_MS=10000
BREVO_SMTP_GREETING_TIMEOUT_MS=10000
BREVO_SMTP_SOCKET_TIMEOUT_MS=15000

# --- Google sign-in (optional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/customer/google/callback

# --- Abuse throttling (leave defaults unless ops needs tuning) ---
RATE_LIMIT_ENABLED=true

# ============================================================================
# FRONTEND (Vercel — Project → Settings → Environment Variables)
# ============================================================================

# Backend URL the storefront talks to (PandaStack public URL).
MEDUSA_BACKEND_URL=https://api.yourdomain.com

# Publishable API key (Medusa Admin → Settings → API Keys).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key

# Storefront URL + default region (NG marketplace → ng).
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
NEXT_PUBLIC_DEFAULT_REGION=ng

# Google sign-in toggle (only if GOOGLE_* backend vars are set).
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# --- Image optimization: allow Backblaze/CDN media hosts ---
# Comma-separated hostnames next/image may load from (add your B2 public host
# or CDN domain, e.g. f004.backblazeb2.com or cdn.yourdomain.com).
MEDIA_IMAGE_HOSTNAMES=f004.backblazeb2.com

# ============================================================================
# OPTIONAL OPERATIONS CONSOLE (separate Vercel project)
# ============================================================================
# Vercel project root: backend
# Build command: npm run build:admin
# Output directory: .medusa/admin
# Set these only in the Operations Console Vercel project. The API secrets stay
# on PandaStack; this URL only tells the static Medusa console where to call.
MEDUSA_ADMIN_BACKEND_URL=https://api.yourdomain.com
MEDUSA_ADMIN_PATH=/
