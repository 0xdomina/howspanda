# How's u - production deployment environment
# Copy this file to .env.deploy and fill in REAL values. NEVER commit .env.deploy.
# Generate strong secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Authentication secrets (REQUIRED, must be 32+ random bytes) ---
JWT_SECRET=replace-with-32-byte-random-hex
COOKIE_SECRET=replace-with-32-byte-random-hex

# --- Postgres / Redis (set on the backing services or process-managed) ---
POSTGRES_USER=howsu
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=howsu
REDIS_PASSWORD=replace-with-strong-password

# --- CORS / public URLs ---
PUBLIC_BACKEND_URL=https://api.yourdomain.com
STORE_CORS=https://yourdomain.com
ADMIN_CORS=https://yourdomain.com,https://admin.yourdomain.com
AUTH_CORS=https://yourdomain.com,https://admin.yourdomain.com
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
NEXT_PUBLIC_DEFAULT_REGION=ng
PORT=8080

# --- Frontend publishable key (from Medusa Admin > Settings > API Keys) ---
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key

# --- Payment rails (USDC is the default. mock = offline, deterministic test) ---
# Set to `mock` for offline dev; set REAL values to go live with money.
CIRCLE_API_KEY=mock
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
PAYSTACK_SECRET_KEY=mock