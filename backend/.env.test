# Integration-test env. The medusa-test-utils runner connects to the
# `postgres` maintenance DB as a superuser to create/drop the temporary test
# database, and connects the app to that temp DB (named medusa-*-integration-N).
DATABASE_URL=postgres://howsu:howsu_dev_password@localhost:5432/howsu_test_integration
DB_USERNAME=howsu
DB_PASSWORD=howsu_dev_password
DB_HOST=localhost
DB_PORT=5432
JWT_SECRET=howsu_dev_jwt_secret_change_in_prod
COOKIE_SECRET=howsu_dev_cookie_secret_change_in_prod