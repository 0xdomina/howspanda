DATABASE_URL=postgres://howsu:howsu_dev_password@localhost:5432/howsu
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:9000,http://localhost:5173

# Security (Phase 15) �?" abuse throttling for sensitive routes.
# Enabled by default. Set RATE_LIMIT_ENABLED=false to disable entirely.
# Per-bucket tuning (optional, defaults in src/api/middlewares.ts):
#   RATE_LIMIT_AUTH_LIMIT / RATE_LIMIT_OTP_LIMIT / RATE_LIMIT_REFERRAL_LIMIT
#   RATE_LIMIT_WALLET_LIMIT / RATE_LIMIT_CHECKOUT_LIMIT / RATE_LIMIT_ADMIN_LIMIT
# plus matching RATE_LIMIT_<NAME>_WINDOW_MS for the window (ms).
RATE_LIMIT_ENABLED=true

# AI module — platform-owned ("one brain, many memories")
# AI_PROVIDER: groq | mock | mock-fail  (mock = deterministic canned outputs, no API key needed)
# When AI_PROVIDER=mock|mock-fail ALL router providers resolve to the mock/fail
# model so integration tests stay offline-deterministic.
AI_PROVIDER=mock
AI_MODEL=llama-3.3-70b-versatile
AI_FREE_TIER_MONTHLY_LIMIT=100
GROQ_API_KEY=

# Model router (multi-provider chat) — provider failover keeps a conversation on
# one provider where possible and only retries another provider when needed.
#   AI_ROUTER_PROVIDERS       comma-separated enabled ids (default: groq)
#   AI_ROUTER_STRATEGY        round-robin | failover (default: failover)
#   AI_BUYER_CHAT_DAILY_LIMIT free buyer-chat turns per actor per day (default 30)
AI_ROUTER_PROVIDERS=groq
AI_ROUTER_STRATEGY=failover
AI_BUYER_CHAT_DAILY_LIMIT=30
# DeepSeek (via @ai-sdk/deepseek). Enable by adding "deepseek" to
# AI_ROUTER_PROVIDERS and setting a key here.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Generic OpenAI-compatible providers (NVIDIA NIM, vLLM, Ollama, ...) — add any
# OpenAI-compatible endpoint with NO code change. Format: a JSON array of
# {"id","model","baseURL","apiKey?","headers?"}; reference the id in
# AI_ROUTER_PROVIDERS. Example:
#   AI_ROUTER_EXTRA_PROVIDERS=[{"id":"nvidia","model":"nvidia/nemotron-4-340b-instruct","baseURL":"https://integrate.api.nvidia.com/v1","apiKey":"nvapi-..."}]
AI_ROUTER_EXTRA_PROVIDERS=

# Payments — fiat (Nigeria-first; test keys work immediately, no KYC to build)
# Set a key to the literal "mock" (or leave blank) for deterministic offline mode.
PAYSTACK_SECRET_KEY=mock
PAYSTACK_PUBLIC_KEY=
PAYSTACK_ENABLED=false
FLUTTERWAVE_SECRET_KEY=mock
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENABLED=false
PAYMENT_DEFAULT_CURRENCY=ngn

# Runtime operations defaults. After the first boot, the Operations Control
# API persists feature switches in PostgreSQL; these values seed missing rows
# and remain useful as emergency defaults for a fresh environment.
FEATURE_MALLS=true
FEATURE_NIN_VERIFICATION=true

# Payments — crypto (testnet PoC via Circle developer-controlled wallets)
CRYPTO_ENABLED=true
CRYPTO_NETWORK_ENV=testnet          # testnet | mainnet
CRYPTO_DEFAULT_NETWORK=base         # base | solana
CIRCLE_API_KEY=mock
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_ACCOUNT_TYPE=SCA           # SCA for sponsored/batched gas; EOA for simpler wallets
# Set true only after Circle testnet/mainnet credentials and reconciliation are ready.
WALLET_RECONCILE_ENABLED=false
# Current NGN->USDC quote rate from the approved pricing process.
# Required when CRYPTO_ENABLED=true in production. Keep it current; checkout
# refuses to use a hidden fallback.
CRYPTO_NGN_PER_USDC=

# Optional: Arc network user wallets (direct L1, USDC-native, no Circle key).
# Only used when CRYPTO_DEFAULT_NETWORK=arc and a key is present; otherwise
# Arc falls back to the mock signer like every other offline setup.
# ARC_MNEMONIC=
# ARC_PRIVATE_KEY=
# ARC_RPC_URL=https://rpc.testnet.arc.io

# Payouts & settlement (Phase 5)
# Escrow release & returns (Phase 6) — replaces PAYOUT_CLEARANCE_DAYS
ESCROW_RETURN_WINDOW_DAYS=3        # buyer complaint window after delivery
ESCROW_FALLBACK_RELEASE_DAYS=30    # auto-release when delivery is never recorded
PAYOUT_MIN_NGN=5000                # minimum available NGN (major units) per payout
PAYOUT_SCHEDULE_ENABLED=false      # cron payouts off by default in dev
# Paystack Transfers reuses PAYSTACK_SECRET_KEY; Circle payouts reuse CIRCLE_*.

# KYC (Phase 14) — progressive identity ladder for couriers & sellers.
# Local dev default is OFF; production on Pandastack MUST be ON to send real emails.
# Pandastack env → set KYC_VERIFICATION_ENABLED=true, KYC_VERIFICATION_CHANNEL=email,
# and ensure NOTIFICATIONS_* + BREVO_* below are set. Otherwise /auth/otp/request
# silently stores a code but never emails it — register will show “sent” but no OTP arrives.
KYC_VERIFICATION_ENABLED=false       # dev default; set true in production
KYC_VERIFICATION_CHANNEL=mock        # mock | email | whatsapp — use email in production with Brevo
KYC_EMAIL_API_KEY=                   # Resend-style email API key (not needed when using Brevo)
KYC_EMAIL_FROM=verify@howsu.local
KYC_WHATSAPP_ACCESS_TOKEN=           # WhatsApp Business Cloud API token
KYC_WHATSAPP_PHONE_NUMBER_ID=        # dedicated WhatsApp sender number id
# Courier offer gate — OFF by default so delivery flows are unchanged.
KYC_COURIER_GATE_ENABLED=false

# Growth/referrals (Phase 9)
REFERRAL_SELLER_REWARD_NGN=2000          # reward per qualified referral
REFERRAL_SELLER_LIFETIME_CAP_NGN=1500000 # lifetime cap per referrer

# Media storage — S3-compatible object store (Backblaze B2 in production).
# Unset in dev: uploads go to local disk under ./uploads and are served from
# /uploads. Set all of S3_BUCKET/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY (plus
# S3_URL/S3_REGION/S3_ENDPOINT) to store media on B2 instead — required on
# ephemeral containers (Pandastack etc.).
#S3_URL=https://f004.backblazeb2.com/your-bucket
#S3_BUCKET=your-bucket
#S3_REGION=us-west-004
#S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_PREFIX=

# Payment proofs contain private buyer/seller financial evidence. Use a
# separate private B2 bucket; the backend returns five-minute signed read URLs.
# These values must never be exposed to the frontend.
#PRIVATE_S3_BUCKET=your-private-proof-bucket
#PRIVATE_S3_REGION=us-west-004
#PRIVATE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#PRIVATE_S3_ACCESS_KEY_ID=
#PRIVATE_S3_SECRET_ACCESS_KEY=
#PRIVATE_S3_PREFIX=payment-proofs
#PRIVATE_S3_FORCE_PATH_STYLE=true

# Payment webhook reliability (optional)
WEBHOOK_DELAY_MS=5000
WEBHOOK_RETRIES=3

# Google sign-in (optional — activates automatically when both are set)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_CALLBACK_URL=

